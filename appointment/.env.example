# Copy to .env (or export in the shell). Real secrets only on the server — never commit them.

# HTTP port of the service
PORT=8080

# PostgreSQL connection (docker-compose.yml provides a matching local instance)
DB_URL=jdbc:postgresql://localhost:5432/appointment
DB_USER=postgres
DB_PASSWORD=postgres

# --- Security (set both before exposing this service) ---
# Bearer token for /api/**. The ops console asks for it and keeps it in sessionStorage.
API_TOKEN=change-me-to-a-long-random-string
# Shared secret for /voice/** webhooks; this service appends it to every URL it hands to Vobiz.
WEBHOOK_SECRET=change-me-to-another-long-random-string
# true = refuse to start when the config below still looks like a local placeholder.
APP_REQUIRE_PRODUCTION_CONFIG=false
# true = seed demo agents/doctor/patient. Never enable against a live database.
APP_SEED_DEMO_DATA=true
# Log verbosity for com.vobiz.masking (info in production, debug locally).
LOG_LEVEL=info
# Reminder scheduler on/off (the scan interval itself is the reminder_scan_ms setting, in the console).
REMINDER_SCHEDULER_ENABLED=true

# Public base URL of THIS service. Vobiz must reach it over HTTPS in production
# (a tunnel such as ngrok/cloudflared is fine for first tests).
PUBLIC_BASE_URL=https://your-public-host.example.com

# The single masked DID (M1) the outside world calls. Also editable in the UI settings.
M1_NUMBER=+10000000000

# Vobiz REST credentials (used only for outbound click-to-call). Sent as
# X-Auth-ID / X-Auth-Token headers; the XML webhooks themselves need no auth.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_API_BASE=https://api.vobiz.example.com

# true = log outbound calls instead of calling the Vobiz API (default until credentials are set)
VOBIZ_MOCK=true

# NOTE: all appointment/IVR/reminder behaviour (clinic name, timezone, quiet hours, scan interval,
# ivr_enabled, templates, ...) lives in the PostgreSQL `settings` / `message_templates`
# tables — edit them from the ops console at / (Settings / Prompts tabs), not here.
