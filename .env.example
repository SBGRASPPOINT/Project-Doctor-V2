# Copy to .env (or export in the shell) for the prescription app in this directory.
# The appointment service has its own file: appointment/.env.example

PORT=3000

# MySQL (see prescription.sql for the schema)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=prescription_app
DB_POOL_SIZE=10

# Required as the x-api-key header by /api/admin/*. Leave empty only for local development.
API_KEY=

# Comma-separated CORS allow-list, e.g. https://clinic.example.com. Empty = same-origin only.
ALLOWED_ORIGINS=
